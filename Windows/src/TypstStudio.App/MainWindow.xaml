<Window x:Class="TypstStudio.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:TypstStudio.App" Title="Typst Studio">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <MenuBar Background="Transparent">
   <MenuBarItem Title="文件"><MenuFlyoutItem Text="开始页" Click="Home_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="打开文件夹…" Click="OpenFolder_Click"/><MenuFlyoutItem Text="打开文件…" Click="OpenFile_Click"/><MenuFlyoutItem Text="从模板新建…" Click="New_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="保存" Click="Save_Click"/><MenuFlyoutItem Text="保存副本…" Click="SaveCopy_Click"/><MenuFlyoutItem Text="导出 PDF…" Click="Export_Click"/></MenuBarItem>
   <MenuBarItem Title="编辑"><MenuFlyoutItem Text="查找…" Click="Find_Click"/></MenuBarItem>
   <MenuBarItem Title="视图"><MenuFlyoutItem Text="返回文档" Click="Back_Click"/><MenuFlyoutItem Text="适合宽度" Click="Fit_Click"/><MenuFlyoutItem Text="放大 PDF" Click="ZoomIn_Click"/><MenuFlyoutItem Text="缩小 PDF" Click="ZoomOut_Click"/></MenuBarItem>
   <MenuBarItem Title="排版"><MenuFlyoutItem Text="编译" Click="Compile_Click"/><MenuFlyoutItem Text="定位到 PDF" Click="Forward_Click"/><MenuFlyoutItem Text="编译问题" Click="Problems_Click"/></MenuBarItem>
   <MenuBarItem Title="工具"><MenuFlyoutItem Text="设置…" Click="Settings_Click"/></MenuBarItem>
  </MenuBar>
  <Grid Grid.Row="1" x:Name="Welcome">
   <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Margin="24,48">
    <Image Source="Assets/Studio.png" Width="128" Height="128" Margin="0,0,0,12"/><TextBlock Text="Typst Studio" FontSize="40" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Windows · Version 0.1.0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,28"/>
    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="22,20" Click="OpenFolder_Click"><StackPanel Orientation="Horizontal" Spacing="20"><SymbolIcon Symbol="Folder" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/><TextBlock Text="打开文件夹…" FontSize="20"/></StackPanel></Button>
    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="22,20" Click="New_Click"><StackPanel Orientation="Horizontal" Spacing="20"><SymbolIcon Symbol="Add" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/><TextBlock Text="从模板新建工程…" FontSize="20"/></StackPanel></Button>
    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="22,20" Click="OpenFile_Click"><StackPanel Orientation="Horizontal" Spacing="20"><SymbolIcon Symbol="Document" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/><TextBlock Text="打开文件…" FontSize="20"/></StackPanel></Button>
    <TextBlock Text="打开文件时，其所在文件夹将作为工程。" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,8"/>
   </StackPanel></ScrollViewer>
   <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="32,40"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="最近工程" Style="{ThemeResource SubtitleTextBlockStyle}"/><ScrollViewer Grid.Row="1" Margin="0,24,0,0"><StackPanel x:Name="RecentProjects" Spacing="8"/></ScrollViewer></Grid></Border>
  </Grid>
  <ScrollViewer Grid.Row="1" x:Name="SettingsPage" Visibility="Collapsed"><StackPanel x:Name="SettingsContent" MaxWidth="1000" Margin="32,24,32,40" Spacing="8" HorizontalAlignment="Stretch"/></ScrollViewer>
  <Grid Grid.Row="1" x:Name="Workspace" Visibility="Collapsed">
   <Grid.ColumnDefinitions><ColumnDefinition Width="220" MinWidth="160"/><ColumnDefinition Width="*" MinWidth="280"/><ColumnDefinition Width="*" MinWidth="280"/></Grid.ColumnDefinitions>
   <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="8">
    <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="工程文件" FontWeight="SemiBold" Margin="8"/>
     <AutoSuggestBox x:Name="FileFilter" Grid.Row="1" PlaceholderText="筛选文件" TextChanged="FileFilter_TextChanged" QueryIcon="Find"/>
     <TreeView x:Name="Files" Grid.Row="2" ItemInvoked="Files_ItemInvoked" SelectionMode="Single"/>
    </Grid>
   </Border>
   <Border Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Padding="12,8" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="EditorTitle" Text="尚未打开文档" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <Button Grid.Column="1" Content="定位到 PDF →" Click="Forward_Click" ToolTipService.ToolTip="Ctrl+Shift+J"/>
     </Grid>
     <TextBox x:Name="Editor" Grid.Row="1" FontFamily="Cascadia Mono, Consolas" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" TextChanged="Editor_TextChanged" SelectionChanged="Editor_SelectionChanged" KeyDown="Editor_KeyDown" Paste="Editor_Paste" IsReadOnly="True" BorderThickness="0" CornerRadius="0" Background="Transparent" Padding="14">
      <TextBox.Resources><SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/><SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/><SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/><Thickness x:Key="TextControlBorderThemeThickness">0</Thickness><Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness></TextBox.Resources>
     </TextBox>
     <Grid Grid.Row="2" Padding="12,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PositionText" Text="行 1，列 1" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button Grid.Column="1" Content="查找" Click="Find_Click"/></Grid>
    </Grid>
   </Border>
   <Border Grid.Column="2" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Padding="8" Spacing="8"><Button Content="−" Click="ZoomOut_Click"/><Button Content="适合宽度" Click="Fit_Click"/><Button Content="+" Click="ZoomIn_Click"/><TextBlock x:Name="PdfTitle" Text="PDF 预览" VerticalAlignment="Center" FontSize="12"/></StackPanel>
     <local:PdfViewer x:Name="Preview" Grid.Row="1"/>
    </Grid>
   </Border>
  </Grid>
  <Grid Grid.Row="2" Padding="12,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" Margin="0,0,8,0"/>
   <TextBlock x:Name="Status" Grid.Column="1" Text="打开工程文件夹，开始编写 Typst 文档。" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"/>
   <Button Grid.Column="2" x:Name="ProblemsButton" Content="问题" Click="Problems_Click"/>
  </Grid>
 </Grid>
</Window>
