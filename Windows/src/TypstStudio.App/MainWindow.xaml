<Window x:Class="TypstStudio.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:TypstStudio.App" Title="Typst Studio">
 <Grid x:Name="Root" Background="{ThemeResource SubtleFillColorTransparentBrush}" KeyboardAcceleratorPlacementMode="Hidden">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="StudioTitleBar" Height="{ThemeResource TitleBarHeight}" Background="{ThemeResource SubtleFillColorTransparentBrush}" Padding="{ThemeResource HeaderPadding}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="CaptionInsetColumn" Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel x:Name="TitleLeft" Orientation="Horizontal" Spacing="{ThemeResource Space8}" VerticalAlignment="Center"><Image Source="Assets/Studio.png" Width="{ThemeResource FontIcon}" Height="{ThemeResource FontIcon}"/><Button x:Name="RestoreSidebarButton" Visibility="Collapsed" Style="{ThemeResource StudioIconButton}" Click="ToggleSidebar_Click"><FontIcon Glyph="&#xE700;" FontFamily="{ThemeResource StudioIconFont}" FontSize="{ThemeResource FontIcon}"/></Button></StackPanel>
  <MenuBar x:Name="MainMenu" Grid.Column="1" FontSize="{ThemeResource FontBody}" FontFamily="{ThemeResource StudioUIFont}" Background="Transparent">
   <MenuBarItem Title="文件"><MenuFlyoutItem Text="开始页" Click="Home_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="打开文件夹…" Click="OpenFolder_Click"/><MenuFlyoutItem Text="打开文件…" Click="OpenFile_Click"/><MenuFlyoutItem Text="从模板新建…" Click="New_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="保存" Click="Save_Click"/><MenuFlyoutItem Text="保存副本…" Click="SaveCopy_Click"/><MenuFlyoutItem Text="导出 PDF…" Click="Export_Click"/></MenuBarItem>
   <MenuBarItem Title="编辑"><MenuFlyoutItem Text="撤销" Click="Undo_Click"/><MenuFlyoutItem Text="重做" Click="Redo_Click"/><MenuFlyoutItem Text="切换行注释" Click="Comment_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="查找…" Click="Find_Click"/></MenuBarItem>
   <MenuBarItem Title="视图"><MenuFlyoutItem Text="显示/隐藏侧边栏" Click="ToggleSidebar_Click"/><ToggleMenuFlyoutItem x:Name="WrapMenuItem" Text="自动换行" Click="Wrap_Click"/><MenuFlyoutItem Text="重置分栏" Click="ResetSplit_Click"/><MenuFlyoutItem Text="返回文档" Click="Back_Click"/><MenuFlyoutItem Text="适合宽度" Click="Fit_Click"/><MenuFlyoutItem Text="放大 PDF" Click="ZoomIn_Click"/><MenuFlyoutItem Text="缩小 PDF" Click="ZoomOut_Click"/></MenuBarItem>
   <MenuBarItem Title="排版"><MenuFlyoutItem Text="编译" Click="Compile_Click"/><MenuFlyoutItem Text="定位到 PDF" Click="Forward_Click"/><MenuFlyoutItem Text="编译问题" Click="Problems_Click"/></MenuBarItem>
   <MenuBarItem Title="工具"><MenuFlyoutItem Text="设置…" Click="Settings_Click"/></MenuBarItem>
  </MenuBar>
   <TextBlock x:Name="TitleFileName" Grid.ColumnSpan="4" Style="{ThemeResource StudioBodyStrong}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="{ThemeResource TitleMaxWidth}" IsHitTestVisible="False" Visibility="Collapsed"/>
  </Grid>
  <Grid Grid.Row="1" x:Name="Welcome">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="WelcomeRightColumn" Width="{ThemeResource WelcomeRecentWidth}"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition x:Name="WelcomeBrandRow" Height="*"/><RowDefinition x:Name="WelcomeRecentRow" Height="0"/></Grid.RowDefinitions>

   <StackPanel x:Name="BrandArea" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{ThemeResource Pad24}">
    <Image Source="Assets/Studio.png" Width="{ThemeResource WelcomeIconSize}" Height="{ThemeResource WelcomeIconSize}" Margin="{ThemeResource BrandGap}"/>
    <TextBlock Text="Typst Studio" Style="{ThemeResource StudioTitle}" HorizontalAlignment="Center"/>
    <TextBlock x:Name="WelcomeVersion" Text="Windows · Version 0.2.0" Style="{ThemeResource StudioCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="{ThemeResource TitleGap}"/>
    <StackPanel Spacing="{ThemeResource Space8}">
     <Button x:Name="WelcomeFolderButton" Style="{ThemeResource StudioWelcomeButton}" Click="OpenFolder_Click" ToolTipService.ToolTip="打开文件夹… (Ctrl+O)"><Grid ColumnSpacing="{ThemeResource Space12}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8B7;" FontFamily="{ThemeResource StudioIconFont}" FontSize="{ThemeResource FontIcon}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Grid.Column="1" Text="打开文件夹…" Style="{ThemeResource StudioBody}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="Ctrl+O" Style="{ThemeResource StudioCaption}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/></Grid></Button>
     <Button x:Name="WelcomeTemplateButton" Style="{ThemeResource StudioWelcomeButton}" Click="New_Click" ToolTipService.ToolTip="从模板新建工程… (Ctrl+N)"><Grid ColumnSpacing="{ThemeResource Space12}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE710;" FontFamily="{ThemeResource StudioIconFont}" FontSize="{ThemeResource FontIcon}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Grid.Column="1" Text="从模板新建工程…" Style="{ThemeResource StudioBody}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="Ctrl+N" Style="{ThemeResource StudioCaption}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/></Grid></Button>
     <Button x:Name="WelcomeFileButton" Style="{ThemeResource StudioWelcomeButton}" Click="OpenFile_Click" ToolTipService.ToolTip="打开文件… (Ctrl+Shift+O)"><Grid ColumnSpacing="{ThemeResource Space12}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8E5;" FontFamily="{ThemeResource StudioIconFont}" FontSize="{ThemeResource FontIcon}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Grid.Column="1" Text="打开文件…" Style="{ThemeResource StudioBody}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="Ctrl+Shift+O" Style="{ThemeResource StudioCaption}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/></Grid></Button>
    </StackPanel>
    <TextBlock Text="打开文件时，其所在文件夹将作为工程。" Style="{ThemeResource StudioCaption}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="{ThemeResource HintGap}" TextWrapping="Wrap" MaxWidth="{ThemeResource WelcomeActionsWidth}"/>
   </StackPanel>
   <Grid x:Name="RecentArea" Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock x:Name="RecentHeading" Text="最近工程" Style="{ThemeResource StudioSubtitle}" Margin="{ThemeResource RecentTitleMargin}"/>
    <ListView x:Name="RecentProjects" Grid.Row="1" Margin="{ThemeResource Pad24}" IsItemClickEnabled="True" ItemClick="RecentProjects_ItemClick" SelectionMode="Single" Background="{ThemeResource SubtleFillColorTransparentBrush}">
     <ListView.ItemTemplate><DataTemplate><Grid Height="{ThemeResource RecentRowHeight}" Padding="{ThemeResource RecentPadding}" ColumnSpacing="{ThemeResource Space12}" PointerEntered="RecentRow_PointerEntered" PointerExited="RecentRow_PointerExited" GotFocus="RecentRow_GotFocus">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE8B7;" FontFamily="{ThemeResource StudioIconFont}" FontSize="{ThemeResource FontIcon}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Path}"><TextBlock Text="{Binding Name}" Style="{ThemeResource StudioBodyStrong}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><Grid HorizontalAlignment="Left" MaxWidth="{ThemeResource RecentPathMaxWidth}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Prefix}" TextWrapping="NoWrap" Style="{ThemeResource StudioCaption}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Tail}" TextWrapping="NoWrap" Style="{ThemeResource StudioCaption}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/></Grid></StackPanel>
      <Button x:Name="RecentMore" Grid.Column="2" Tag="{Binding Path}" Style="{ThemeResource StudioIconButton}" Click="RecentMore_Click" Opacity="0" ToolTipService.ToolTip="更多操作"><FontIcon Glyph="&#xE712;" FontFamily="{ThemeResource StudioIconFont}" FontSize="{ThemeResource FontIcon}"/></Button>
     </Grid></DataTemplate></ListView.ItemTemplate>
    </ListView>
    <StackPanel x:Name="RecentEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{ThemeResource Space12}" Margin="{ThemeResource Pad24}"><FontIcon Glyph="&#xE8B7;" FontFamily="{ThemeResource StudioIconFont}" FontSize="{ThemeResource FontTitle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/><TextBlock Text="还没有最近工程" Style="{ThemeResource StudioBody}" HorizontalAlignment="Center"/><TextBlock Text="打开一个文件夹后，它会出现在这里。" Style="{ThemeResource StudioCaption}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center"/></StackPanel>
   </Grid>
  </Grid>
  <ScrollViewer Grid.Row="1" x:Name="SettingsPage" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><Grid Padding="{ThemeResource Inset24_16_24_32}"><StackPanel x:Name="SettingsContent" MaxWidth="{ThemeResource SettingsWidth}" Spacing="{ThemeResource Gap6}" HorizontalAlignment="Stretch"/></Grid></ScrollViewer>
  <Grid Grid.Row="1" x:Name="Workspace" Visibility="Collapsed"><Grid.ChildrenTransitions><TransitionCollection><RepositionThemeTransition/></TransitionCollection></Grid.ChildrenTransitions>
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="{ThemeResource SidebarDefaultWidth}" MinWidth="{ThemeResource SidebarMinWidth}"/><ColumnDefinition x:Name="SidebarDividerColumn" Width="{ThemeResource DividerHitWidth}"/><ColumnDefinition x:Name="EditorColumn" Width="*" MinWidth="{ThemeResource EditorMinWidth}"/><ColumnDefinition Width="{ThemeResource DividerHitWidth}"/><ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="{ThemeResource EditorMinWidth}"/></Grid.ColumnDefinitions>
   <local:PaneDivider x:Name="SidebarDivider" Grid.Column="1" DragDelta="SidebarDivider_DragDelta" DragCompleted="Divider_DragCompleted" Background="{ThemeResource DividerStrokeColorDefaultBrush}" ToolTipService.ToolTip="Resize project pane"/>
   <local:PaneDivider x:Name="DocumentDivider" Grid.Column="3" DragDelta="DocumentDivider_DragDelta" DragCompleted="Divider_DragCompleted" Background="{ThemeResource DividerStrokeColorDefaultBrush}" ToolTipService.ToolTip="Resize editor and PDF"/>
   <Border x:Name="SidebarContainer" Background="{ThemeResource SubtleFillColorTransparentBrush}" Padding="{ThemeResource Pad8}">
    <Grid RowSpacing="{ThemeResource Space8}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="{ThemeResource EditorHeaderHeight}"/></Grid.RowDefinitions>
     <local:SidebarTabs x:Name="SidebarPicker" Height="{ThemeResource ControlHeightStandard}" SelectionChanged="SidebarPicker_SelectionChanged"/>
     <ContentControl x:Name="SidebarTools" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><ContentControl.ContentTransitions><TransitionCollection><ContentThemeTransition/></TransitionCollection></ContentControl.ContentTransitions></ContentControl>
     <AutoSuggestBox x:Name="FileFilter" Grid.Row="1" PlaceholderText="筛选文件" TextChanged="FileFilter_TextChanged" QueryIcon="Find"/>
     <TreeView x:Name="Files" Grid.Row="2" ItemInvoked="Files_ItemInvoked" SelectionMode="Single" Expanding="Files_Expanding" ItemContainerStyle="{ThemeResource StudioTreeItem}">
      <TreeView.ItemTemplate><DataTemplate><TreeViewItem ItemsSource="{Binding Children}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Style="{ThemeResource StudioTreeItem}"><StackPanel Orientation="Horizontal" Spacing="{ThemeResource Gap8}"><FontIcon Glyph="{Binding Content.Glyph}" FontSize="{ThemeResource FontIcon}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="{Binding Content.Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></StackPanel></TreeViewItem></DataTemplate></TreeView.ItemTemplate>
     </TreeView>
     <StackPanel x:Name="SidebarToolbar" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="{ThemeResource Space4}"/>
    </Grid>
   </Border>
   <Grid Grid.Column="2" x:Name="EditorSurface" Background="{ThemeResource LayerFillColorDefaultBrush}">
    <Grid.RowDefinitions><RowDefinition Height="{ThemeResource EditorHeaderHeight}"/><RowDefinition Height="*"/><RowDefinition Height="{ThemeResource FormatBarHeight}"/></Grid.RowDefinitions>
    <Grid Padding="{ThemeResource HeaderPadding}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="EditorTitle" Text="尚未打开文档" Style="{ThemeResource StudioBodyStrong}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" x:Name="ForwardButton" Style="{ThemeResource StudioIconButton}" Click="Forward_Click"><FontIcon Glyph="&#xE72A;" FontFamily="{ThemeResource StudioIconFont}" FontSize="{ThemeResource FontIcon}"/></Button></Grid>
    <local:SourceEditor x:Name="Editor" Grid.Row="1" FontSize="{ThemeResource FontCode}" TextChanged="Editor_TextChanged" SelectionChanged="Editor_SelectionChanged" KeyDown="Editor_KeyDown"/>
    <Border x:Name="FindOverlay" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{ThemeResource Pad12}" Padding="{ThemeResource Pad8}" CornerRadius="{ThemeResource OverlayCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="{ThemeResource ThinBorder}">
     <StackPanel Spacing="{ThemeResource Space8}"><Grid ColumnSpacing="{ThemeResource Space4}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FindQuery" PlaceholderText="查找" KeyDown="FindQuery_KeyDown"/><StackPanel x:Name="FindActions" Grid.Column="1" Orientation="Horizontal"/></Grid><Grid x:Name="ReplaceRow" Visibility="Collapsed" ColumnSpacing="{ThemeResource Space4}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ReplaceQuery" PlaceholderText="替换为"/><Button Grid.Column="1" Content="替换" Click="ReplaceOne_Click"/><Button Grid.Column="2" Content="全部" Click="ReplaceAll_Click"/></Grid><TextBlock x:Name="FindResult" Style="{ThemeResource StudioCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
    </Border>
    <Grid Grid.Row="2" Padding="{ThemeResource ToolbarPadding}" ColumnSpacing="{ThemeResource Space8}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel x:Name="FormatToolbar" Orientation="Horizontal" VerticalAlignment="Center"/><TextBlock x:Name="PositionText" Grid.Column="1" HorizontalAlignment="Right" MaxWidth="{ThemeResource EditorStatusMaxWidth}" TextTrimming="CharacterEllipsis" Style="{ThemeResource StudioCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/></Grid>
   </Grid>
   <Grid Grid.Column="4" Background="{ThemeResource LayerFillColorDefaultBrush}"><Grid.RowDefinitions><RowDefinition Height="{ThemeResource EditorHeaderHeight}"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="PdfToolbar" Padding="{ThemeResource ToolbarPadding}" ColumnSpacing="{ThemeResource Space4}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel x:Name="PdfLeftActions" Orientation="Horizontal"/><Button x:Name="PageButton" Grid.Column="1" Click="PageButton_Click" Background="{ThemeResource SubtleFillColorTransparentBrush}" BorderThickness="{ThemeResource Zero}" Padding="{ThemeResource Zero}" HorizontalAlignment="Center"><TextBlock x:Name="PageLabel" Text="0 / 0" Style="{ThemeResource StudioCaption}"/></Button><StackPanel Grid.Column="2" x:Name="PdfRightActions" Orientation="Horizontal"/></Grid>
    <local:PdfViewer x:Name="Preview" Grid.Row="1"/>
   </Grid>
  </Grid>
  <Grid x:Name="StatusArea" Grid.Row="2" Height="{ThemeResource StatusBarHeight}" Padding="{ThemeResource ControlPadding}" ColumnSpacing="{ThemeResource Space8}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid><ProgressRing x:Name="Busy" IsActive="False" Width="{ThemeResource FontIconLarge}" Height="{ThemeResource FontIconLarge}"/><FontIcon x:Name="CompileStateIcon" FontFamily="{ThemeResource StudioIconFont}" FontSize="{ThemeResource FontIcon}"/></Grid>
   <TextBlock x:Name="PdfTitle" Visibility="Collapsed"/><Button x:Name="StatusButton" Grid.Column="1" Click="StatusButton_Click" Height="{ThemeResource Space24}" MinHeight="{ThemeResource Space24}" HorizontalContentAlignment="Left" Padding="{ThemeResource Zero}" Background="{ThemeResource SubtleFillColorTransparentBrush}" BorderThickness="{ThemeResource Zero}"><TextBlock x:Name="Status" Text="打开工程文件夹，开始编写 Typst 文档。" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{ThemeResource StudioCaption}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/></Button>
   <TextBlock Grid.Column="2" x:Name="AppVersionLabel" Text="Typst Studio 0.2.0" Style="{ThemeResource StudioCaption}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
  </Grid>
 </Grid>
</Window>
